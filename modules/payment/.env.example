# Payment Management environment template
# Copy this file to modules/payment/.env for local development only.
# In HostForge, create protected Environment Variables with the same names.
# Never commit modules/payment/.env or place real secrets in this template.

# Application
APP_ENV="production"
APP_DEBUG="false"
APP_BASE_URL="https://payment.example.com"

# Payment database (preferred names)
PAYMENT_DB_HOST="127.0.0.1"
PAYMENT_DB_PORT="3306"
PAYMENT_DB_DATABASE="payment_db"
PAYMENT_DB_USER="payment_user"
PAYMENT_DB_PASS="replace_with_secret"
PAYMENT_DB_CHARSET="utf8mb4"

# PayMongo TEST
PAYMONGO_PK_TEST="pk_test_replace_me"
PAYMONGO_SK_TEST="sk_test_replace_me"
PAYMONGO_WHSEC_TEST="whsk_replace_me"

# PayMongo LIVE
PAYMONGO_PK_LIVE="pk_live_replace_me"
PAYMONGO_SK_LIVE="sk_live_replace_me"
PAYMONGO_WHSEC_LIVE="whsk_replace_me"

# Google Cloud Vision OCR
OCR_MODE="live"
# Recommended for HostForge: Base64 of the complete service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS_BASE64="base64_encoded_service_account_json"
# Alternative for a securely mounted credential file. Leave unused when the
# Base64 variable above is configured.
GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/google-credentials.json"
